# dependencies
node_modules/
.pnpm-store/
**/__pycache__/
*.pyc
.venv/
venv/
services/review-gen/.venv/

# build output
dist/
build/
.next/
*.tsbuildinfo

# env / secrets — wildcard then allowlist .env.example
.env
.env.*
!.env.example

# CI / cloud credentials (NEVER commit these to a public repo)
gh-deployer-key.json
*-service-account*.json
*.pem
*.key
*.p12
*.pfx
gcp-sa-*.json

# logs
*.log
logs/

# test
coverage/
.vitest/

# editor / OS
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp

# data — we never persist PDFs to disk
uploads/
*.sqlite
*.db

# stray screenshots in repo root (move to docs/images/ if you want to keep one)
/*.png
/*.jpg
/*.jpeg

# old prototypes that lived under research/
research/_legacy_uploads/
research/_legacy_env/

# prisma generated client (regenerated on install)
apps/api/prisma/generated/

# workflow + agent transcripts (local Claude sessions)
.claude/projects/

# Thesis / ethics document artifacts (kept local, not source).
# Root-level PDFs are exposé / presentation exports; docs/*.pdf would
# still be committable if we ever want one in the repo.
*.docx
*.pptx
/*.pdf

# Database dumps (deploy/backup.sh) and one-off table exports. These hold
# the human vote log — the thesis dataset, and participant data. Never in git.
backups/

# Private working documents — thesis drafts, runbooks, internal notes.
# Deliberately never committed: purged from history 2026-09-07 and kept
# local only. Back them up outside the repo.
docs/
