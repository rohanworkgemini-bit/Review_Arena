# ReviewArena environment. Copy to .env and fill in. NEVER commit .env.
# docker-compose.prod.yml reads this same file on the VM (env_file + the
# two compose-level vars at the bottom).

# ─── Database (dev: local docker compose postgres) ─────────────────────
DATABASE_URL=postgresql://reviewarena:reviewarena@localhost:5432/reviewarena

# ─── Node API ──────────────────────────────────────────────────────────
API_PORT=8000
# 32+ chars random each; PAIR_TOKEN_SECRET also signs the session cookie.
ADMIN_TOKEN=change-me-32-chars-minimum-random
PAIR_TOKEN_SECRET=change-me-32-chars-minimum-random
# Comma-separated CORS whitelist (the browser origin(s)).
WEB_ORIGIN=http://localhost:5173
REVIEW_GEN_URL=http://localhost:8001
# Shared key the API sends to review-gen as X-API-Key. Required in
# production on BOTH sides (review-gen refuses to boot without it).
REVIEW_GEN_API_KEY=change-me-32-chars-minimum-random
# System pinned to 1000 on the Bradley-Terry leaderboard.
RATING_BASELINE_SLUG=claude-sonnet-5

# ─── review-gen (Python) ───────────────────────────────────────────────
# Local dev only — lets the service boot keyless. NEVER set on the VM.
#REVIEWARENA_ENV=development
# Review systems: Claude Sonnet 5, DeepSeek V4 Flash, Gemini 3.8 Flash,
# GLM-5.2 (Z.ai), GPT-5.6 Terra, Mistral Medium 3.5. The same six models
# form the LLM judge panel for study papers, so every key below is needed
# for judging too — a missing key drops that system from the lineup AND
# from the panel.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=
# Datalab Chandra (PDF -> markdown parsing).
CHANDRA_API_KEY=
# Optional tuning: per-attempt provider deadline / retry count.
#PROVIDER_TIMEOUT_S=180
#PROVIDER_MAX_RETRIES=3

# ─── docker-compose.prod.yml only ──────────────────────────────────────
# Strong random password for the compose-internal postgres.
POSTGRES_PASSWORD=
# Public hostname for Caddy (automatic HTTPS), or ":80" for firewalled tests.
SITE_ADDRESS=arena.example.tu-darmstadt.de
# Same host, used for the API's CORS whitelist inside compose.
SITE_HOST=arena.example.tu-darmstadt.de

# Kill switch for the LLM judge panel. Default true.
# A single study paper is 36 live provider calls (6 judges x 2 passes x 3
# pairs), which is slow and billable while you are testing the upload flow
# or the voting UI. Set to false to skip judging: reviews stay
# judge_status=PENDING and scripts/rescore-missing.ts backfills them once
# it is switched back on.
# MUST be true for the real study — an unjudged pair contributes nothing to RQ2.
JUDGE_ENABLED=true
